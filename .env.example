# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — 09-CLIMA-POR-CIUDAD
# Copie este archivo a .env.local para desarrollo local (NUNCA subir a Git)
# ==============================================================================

# Variables públicas de Firebase (Firebase Web SDK en el navegador)
# Seguras por diseño: solo identifican el proyecto.
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_publica
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef0123456789

# Variables privadas de Firebase Admin SDK (Solo en servidor / Vercel Environment Variables)
# NUNCA utilizar claves reales en archivos versionados.
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
